{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guanxiang-account",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-21",
  "d1_databases": [
    { "binding": "DB", "database_name": "guanxiang-accounts", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://guanxiang-zhouyi-evf.pages.dev,https://guanxiang-zhouyi.liara.run,http://127.0.0.1:4175,http://localhost:4175"
  }
}
