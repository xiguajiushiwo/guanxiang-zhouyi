{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guanxiang-ai-reading",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-11",
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "ReadingRateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReadingRateLimiter"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://guanxiang-zhouyi-evf.pages.dev,https://guanxiang-zhouyi-global.netlify.app,https://guanxiang-zhouyi.liara.run,http://127.0.0.1:4175,http://localhost:4175",
    "AI_MODEL": "@cf/openai/gpt-oss-120b",
    "PER_IP_HOURLY_LIMIT": "5",
    "DAILY_LIMIT": "50",
    "MAX_TOKENS": "6000"
  }
}
