{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guanxiang-ai-reading",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-11",
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "RATE_LIMITS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://YOUR-USER.github.io,http://127.0.0.1:4175,http://localhost:4175",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "PER_IP_HOURLY_LIMIT": "5",
    "DAILY_LIMIT": "50",
    "MAX_TOKENS": "900"
  }
}
